{
  "name": "devhub-extension",
  "displayName": "devHub Companion",
  "description": "VS Code Extension for devHub Internal Developer Portal",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devhub-sidebar-view",
          "title": "devHub",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "devhub-sidebar-view": [
        {
          "type": "webview",
          "id": "devhub.sidebarView",
          "name": "devHub Command Center"
        },
        {
          "id": "devhub.apiExplorerView",
          "name": "API Contract Specs Explorer"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "20.x",
    "typescript": "^5.3.0"
  }
}
