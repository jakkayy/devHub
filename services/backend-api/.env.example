# Go Backend Environment Variables
PORT=8080
ENV=development

# Database Configuration (Local Postgres Port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=devhub
DB_PASSWORD=devhubpass
DB_NAME=devhub_db
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=localhost:6379
REDIS_PASSWORD=

# External Integrations Credentials
GITHUB_PAT=your_github_personal_access_token
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url
GOOGLE_SHEET_ID=your_google_sheet_id
MIRO_OAUTH_TOKEN=your_miro_oauth_token

# Application Timeouts & Limits
API_TIMEOUT_SECONDS=10
